{
  "firestore": {
    "rules": "firestore.rules"
  },
  "hosting": {
    "public": "public",
    "ignore": [
      "firebase.json",
      "**/.*",
      "!**/.well-known/**",
      "**/node_modules/**"
    ],
    "headers": [
      {
        "source": "/.well-known/assetlinks.json",
        "headers": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ]
      }
    ],
    "rewrites": [
      {
        "source": "/plant/**",
        "destination": "/plant.html"
      },
      {
        "source": "/location/**",
        "destination": "/location.html"
      },
      {
        "source": "**",
        "destination": "/index.html"
      }
    ]
  }
}
